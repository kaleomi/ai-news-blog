---
import Base from '../layouts/Base.astro';
import Issue from '../components/Issue.astro';
import IssueList from '../components/IssueList.astro';
import { getIssues } from '../lib/data';

const [latest, ...past] = await getIssues();
---
<Base description={latest ? `第 ${latest.data.issue} 期：${latest.data.title}` : undefined}>
  {latest
    ? <Issue entry={latest} />
    : <p class="empty">第一期周报正在整理。</p>}

  {past.length > 0 && (
    <section class="row block">
      <h2 class="rail rail-title">往期</h2>
      <IssueList issues={past} />
    </section>
  )}
</Base>
