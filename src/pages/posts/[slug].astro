---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { getPosts, fmtDate } from '../../lib/data';
import { SITE } from '../../site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description}>
  <article class="article">
    <header>
      <h1>{post.data.title}</h1>
      <p>{SITE.author}，<time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time></p>
    </header>
    <div class="prose"><Content /></div>
    <a class="back" href="/posts/">返回全部长文</a>
  </article>
</Base>
