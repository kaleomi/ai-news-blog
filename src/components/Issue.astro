---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { hostOf, fmtDay, fmtRange } from '../lib/data';

interface Props { entry: CollectionEntry<'weekly'>; headingLevel?: 1 | 2 }
const { entry, headingLevel = 1 } = Astro.props;
const Heading = headingLevel === 1 ? 'h1' : 'h2';
const { issue, title, from, to, items } = entry.data;
const { Content } = await render(entry);

const featured = items.filter((i) => i.featured);
const ORDER = ['产品', '研究', '动态', '文章'] as const;
const groups = ORDER
  .map((c) => ({ name: c, list: items.filter((i) => !i.featured && i.category === c) }))
  .filter((g) => g.list.length > 0);
const categoryIds = { 产品: 'product', 研究: 'research', 动态: 'news', 文章: 'article' };

const meta = (it: (typeof items)[number]) =>
  [it.date ? fmtDay(it.date) : '', it.source || hostOf(it.url)].filter(Boolean).join('，');
---
<article class="issue">
  <header class="row issue-head">
    <div class="rail">
      <span class="num">{issue}</span>
      <span class="rail-sub">第 {issue} 期</span>
    </div>
    <div>
      <p class="range"><time datetime={from.toISOString().slice(0, 10)}>{fmtRange(from, to)}</time>，共 {items.length} 条</p>
      <Heading class="issue-title">{title}</Heading>
      <div class="prose note"><Content /></div>
      <nav class="issue-jumps" aria-label="本期内容分类">
        {featured.length > 0 && <a href={`#issue-${issue}-featured`}>本周重点 <span>{featured.length}</span></a>}
        {groups.map((g) => <a href={`#issue-${issue}-${categoryIds[g.name]}`}>{g.name} <span>{g.list.length}</span></a>)}
      </nav>
    </div>
  </header>

  {featured.length > 0 && (
    <section class="row block" id={`issue-${issue}-featured`}>
      <h2 class="rail rail-title">本周重点<span class="rail-sub">值得多看一眼</span></h2>
      <ul class="items featured-items">
        {featured.map((it) => (
          <li class="item item-top">
            <span class="cat" data-c={it.category}>{it.category}</span>
            <div>
              <h3>{it.url ? <a href={it.url} target="_blank" rel="noopener">{it.title}</a> : it.title}</h3>
              {it.summary && <p>{it.summary}</p>}
              <span class="src">{meta(it)}</span>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  {groups.map((g) => (
    <section class="row block" id={`issue-${issue}-${categoryIds[g.name]}`}>
      <h2 class="rail rail-title"><span class="cat-name" data-c={g.name}>{g.name}</span><span class="rail-sub">{g.list.length} 条</span></h2>
      <ul class="items">
        {g.list.map((it) => (
          <li class="item">
            <div>
              <h3>{it.url ? <a href={it.url} target="_blank" rel="noopener">{it.title}</a> : it.title}</h3>
              {it.summary && <p>{it.summary}</p>}
              <span class="src">{meta(it)}</span>
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}
</article>
